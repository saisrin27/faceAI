elif st.session_state.current_page == "Comment":
    st.subheader("💬 User Comments & Feedback")
    st.write("Submit comments, suggestions, or reports directly to the administration team.")

    # Load comments from DB
    try:
        db_comments = api.get_comments()
    except Exception as e:
        db_comments = []
        st.error(f"Could not load comments: {e}")

    with st.container():
        st.markdown("""
            <div style='background-color: #f8fafc; border-left: 4px solid #3b82f6; padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1.5rem;'>
                <p style='color: #1e293b; margin: 0; font-size: 0.9rem; font-weight: 500;'>
                    ℹ️ Feedback board is online. Your comments help us improve the platform.
                </p>
            </div>
        """, unsafe_allow_html=True)

        # Display comments (latest first)
        if db_comments:
            for comm in db_comments:
                c_col1, c_col2 = st.columns([12, 1])
                with c_col1:
                    st.markdown(
                        f"""
                        <div style='background-color: #ffffff; padding: 1rem; border-radius: 8px;
                                    margin-bottom: 0.75rem; border: 1px solid #e2e8f0; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);'>
                            <p style='margin: 0; font-size: 0.85rem; color: #64748b;'>
                                <strong style='color: #1e293b;'>🧑‍💻 {comm['user_name']}</strong>
                                <span style='font-size: 0.78rem; margin-left: 0.5rem;'>· {comm['created_at']}</span>
                            </p>
                            <p style='margin: 0.4rem 0 0 0; color: #334155; font-size: 0.95rem; line-height: 1.5;'>{comm['comment_text']}</p>
                        </div>
                        """,
                        unsafe_allow_html=True
                    )
                with c_col2:
                    # Only Admin sees delete button
                    if st.session_state.get("user_role") == "Admin":
                        if st.button("🗑️", key=f"del_comment_{comm['id']}", help="Delete this comment"):
                            try:
                                api.delete_comment(comm["id"])
                                st.success("Comment deleted.")
                                st.rerun()
                            except Exception as ex:
                                st.error(f"Delete failed: {ex}")
        else:
            st.markdown(
                "<p style='color: #94a3b8; text-align: center; padding: 2rem; font-style: italic;'>No comments yet. Be the first to share your thoughts!</p>",
                unsafe_allow_html=True
            )

        st.markdown("<hr style='border-top: 1px solid #e2e8f0; margin: 1.5rem 0;'>", unsafe_allow_html=True)
        
        # Post new comment (uses st.form with clear_on_submit to handle input reset cleanly without session state errors)
        with st.form("new_comment_form", clear_on_submit=True):
            comm_col1, comm_col2 = st.columns([5, 1])
            with comm_col1:
                new_comment = st.text_input(
                    "Write a comment...",
                    placeholder="Type your comment here and click Post...",
                    label_visibility="collapsed"
                )
            with comm_col2:
                submit_comment = st.form_submit_button("Post", type="primary", use_container_width=True)
                
            if submit_comment:
                if new_comment.strip():
                    try:
                        user_id = st.session_state.get("user_id")
                        user_name = st.session_state.get("username", "Anonymous") \
                                    if st.session_state.get("authenticated") else "Anonymous"
                        api.post_comment(user_id, user_name, new_comment.strip())
                        st.success("Comment posted successfully!")
                        st.rerun()
                    except Exception as ex:
                        st.error(f"Failed to post: {ex}")
                else:
                    st.warning("Comment cannot be empty.")




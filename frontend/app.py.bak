    st.markdown("<h1 style='text-align: center; color: white !important; margin: 0; font-weight: 700; font-size: 2.2rem;'>Face AI Attendance System</h1>", unsafe_allow_html=True)
    
    # Navigation buttons inside the header aligned to the user's requested order
    if not st.session_state.authenticated:
        nav_pages = ["Home / Scanner", "Feature", "Techstack", "Comment", "Team", "Login", "Register"]
    else:
        # Determine current Dashboard name
        if st.session_state.user_role == "Admin":
            dash = "Admin Dashboard"
            nav_pages = [dash, "Home / Scanner", "Feature", "Techstack", "Comment", "Team", "Profile", "Report", "Logout"]
        else:
            if st.session_state.user_role == "User":
                dash = "User Dashboard"
            else:
                dash = "Pending Dashboard"
            nav_pages = [dash, "Home / Scanner", "Feature", "Techstack", "Comment", "Team", "Profile", "Logout"]
        
    # Render columns for buttons. Column widths are overridden in CSS to wrap content tightly with constant gaps.
    cols = st.columns(len(nav_pages))
        
    for idx, p in enumerate(nav_pages):
        with cols[idx]:
            is_current = (st.session_state.current_page == p)
            btn_type = "primary" if is_current else "secondary"
            if p == "Logout":
                if st.button("Logout", key="header_nav_logout", type="secondary"):
                    st.session_state.authenticated = False
                    st.session_state.user_role = None
                    st.session_state.username = ""
                    st.session_state.user_id = None
                    st.session_state.approval_status = None
                    st.session_state.current_page = "Home / Scanner"
                    api.clear_token()
                    st.rerun()
            else:
                if st.button(p, key=f"header_nav_{p}", type=btn_type):
                    st.session_state.current_page = p
                    st.rerun()

